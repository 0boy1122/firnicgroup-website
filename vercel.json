{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "index.html",
        "robots.txt",
        "sitemap.xml",
        "admin/**",
        "assets/**",
        "cars/**",
        "contact/**",
        "drivers/**",
        "events/**",
        "hotel/**",
        "massage/**",
        "data/content.json",
        "data/rooms.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
