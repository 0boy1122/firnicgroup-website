# Firnic Group — Environment Variables
# Copy this file to .env and fill in the values

# Groq AI (for Aria chat) — get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Admin panel password (change this!)
ADMIN_PASSWORD=firnic2024

# Email notifications — optional (booking forms fall back to WhatsApp without it)
# Use a Gmail address + App Password (not your real password)
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFY_EMAIL=info@firnicgroup.com
